.category-screen { height:100vh; display:flex; flex-direction:column; overflow:hidden; background:#F5F8FD; }
.category-header { flex-shrink:0; padding-left:32rpx; padding-right:32rpx; padding-bottom:34rpx; box-sizing:border-box; background:linear-gradient(135deg,#3478F6,#78aefa); color:#fff; }
.header-title { font-size:46rpx; font-weight:850; line-height:1.1; }
.header-subtitle { margin-top:9rpx; color:rgba(255,255,255,.9); font-size:24rpx; }
.result-empty,.result-end { color:#9aa7bb; text-align:center; padding:72rpx 8rpx; font-size:22rpx; }
.category-tabs { width:100%; flex-shrink:0; white-space:nowrap; padding:16rpx 28rpx; box-sizing:border-box; }
.tabs-track { display:flex; gap:12rpx; }
.category-tab { flex-shrink:0; padding:13rpx 24rpx; border-radius:40rpx; background:#fff; color:#56657d; font-size:24rpx; border:1rpx solid #e3eaf5; }
.category-tab.active { color:#fff; background:#3478F6; border-color:#3478F6; }
.category-list { flex:1; min-height:0; padding:0 28rpx 28rpx; box-sizing:border-box; }
