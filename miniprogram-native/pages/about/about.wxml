<view class="page about-page">
  <view class="brand card">
    <image src="/static/favicon.png" mode="aspectFill"/>
    <view class="brand-name">AI教程</view>
    <view class="brand-desc">发现更好的 AI 创作方式</view>
  </view>

  <view class="follow-section card">
    <view class="heading">关注我们</view>
    <view wx:for="{{followAccounts}}" wx:key="index" class="follow-account">
      <view class="follow-title">{{item.title}}</view>
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="widthFix" class="follow-image" data-index="{{index}}" bindtap="preview"/>
      <view wx:if="{{item.description}}" class="follow-description">{{item.description}}</view>
    </view>
    <view wx:if="{{!followAccounts.length}}" class="follow-empty">暂无公众号信息</view>
  </view>

  <view class="card menu">
    <button open-type="contact"><text>联系客服</text><text class="arrow">›</text></button>
    <navigator class="menu-link" url="/pages/privacy/privacy"><text>隐私政策</text><text class="arrow">›</text></navigator>
  </view>
</view>
