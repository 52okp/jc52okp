.detail { padding-top:26rpx; padding-bottom:180rpx; }
.featured { display:block; width:100%; height:auto; border-radius:24rpx; margin-bottom:22rpx; background:#eaf1ff; box-shadow:0 12rpx 30rpx rgba(55,100,179,.08); }
.article-heading { padding:34rpx; }
.eyebrow { color:#5383f1; letter-spacing:4rpx; font-size:20rpx; font-weight:800; margin-bottom:14rpx; }
.title { font-size:39rpx; font-weight:850; line-height:1.42; color:#0f1d3a; }
.article-info { display:flex; justify-content:space-between; gap:14rpx; margin-top:22rpx; color:#93a0b5; font-size:21rpx; }
.content { padding:34rpx; line-height:1.8; word-break:break-word; overflow:hidden; color:#273c61; }
.resources { padding:34rpx; }
.section { font-size:31rpx; font-weight:800; margin-bottom:8rpx; }
.resource-desc { font-size:22rpx; }
.link { display:flex; justify-content:space-between; align-items:center; gap:16rpx; padding:25rpx 0; border-bottom:1rpx solid #e9eef7; font-size:25rpx; }
.link-type { font-weight:700; }
.link button { margin:0; padding:0 24rpx; font-size:22rpx; }
.note { font-size:21rpx; line-height:1.6; margin-top:22rpx; }
.actions { position:fixed; bottom:0; left:0; right:0; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.97); box-shadow:0 -8rpx 26rpx rgba(46,82,143,.08); }
.favorite-action { width:100%; height:78rpx; line-height:78rpx; border-radius:99rpx; background:linear-gradient(135deg,#5d91ff,#346cf7); color:#fff; font-size:27rpx; font-weight:700; }
.favorite-action.saved { background:#e7efff; color:#3c6ff0; }
