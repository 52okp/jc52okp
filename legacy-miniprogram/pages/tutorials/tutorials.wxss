.header {
  padding: 12rpx 8rpx 28rpx;
}
.header .title {
  font-size: 44rpx;
  font-weight: 700;
}

.tut-card {
  display: flex;
  align-items: stretch;
}

.cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-default {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tut-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.tut-title {
  font-size: 32rpx;
  font-weight: 600;
}
.tut-summary {
  font-size: 26rpx;
  color: #6b6b78;
  margin: 8rpx 0;
}
.tut-meta {
  display: flex;
  align-items: center;
}
.update {
  margin-left: auto;
}

.empty {
  text-align: center;
  color: #9a9aa8;
  margin-top: 120rpx;
}
