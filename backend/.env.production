# ============================================================
#  生产环境配置模板
#  部署到服务器后：把本文件改名为 .env，并填好下面 MySQL 三项
# ============================================================

# 关闭调试（生产环境必须 false）
APP_DEBUG=false

# 数据配置（改用 MySQL）
DB_TYPE=mysql
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_PREFIX=
DB_MYSQL_CHARSET=utf8mb4
# —— 下面三项在宝塔「数据库」里建好库后填写 ——
DB_MYSQL_DATABASE=改成你的数据库名
DB_MYSQL_USERNAME=改成你的数据库用户名
DB_MYSQL_PASSWORD=改成你的数据库密码

# 缓存配置
CACHE_TYPE=file
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_SELECT=
CACHE_REDIS_PASSWORD=

# 会话配置
SESSION_TYPE=file
SESSION_NAME=ssid
SESSION_STORE=
SESSION_EXPIRE=7200
SESSION_PREFIX=

# 微信小程序（会员登录用，填你的小程序 AppID/AppSecret）
WXAPP_APPID=wx4ec45155a93041cc
WXAPP_SECRET=

# WordPress 教程同步：联调通过前保持维护状态
WP_SYNC_SITE_ID=
WP_SYNC_SECRET=
WP_SYNC_MAINTENANCE=1

# 52okp 更新中心尚未注册本项目；暂不填入其他项目凭据
OSS_ORIGIN=https://app.52okp.com
OSS_PROJECT=
OSS_TOKEN=
APP_VERSION=
