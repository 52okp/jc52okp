.tabbar-root { position:fixed; z-index:99; left:24rpx; right:24rpx; bottom:calc(12rpx + env(safe-area-inset-bottom)); height:116rpx; padding:8rpx; box-sizing:border-box; border:1rpx solid #E7EFF4; border-radius:80rpx; background:rgba(255,255,255,.97); box-shadow:0 8rpx 26rpx rgba(34,66,88,.11); }
.tabbar-inner { position:relative; display:flex; width:100%; height:100%; }
.tab-item { flex:1; min-width:0; display:flex; align-items:center; justify-content:center; color:#3D4757; font-size:21rpx; line-height:1.2; }
.tab-item-content { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; width:112rpx; height:86rpx; box-sizing:border-box; border-radius:30rpx; }
.tab-item.active .tab-item-content { background:#EAF7FC; }
.tab-item.active { color:#168FCC; font-weight:700; }
.tab-item.active .tab-icon { -webkit-filter:brightness(0) saturate(100%) invert(48%) sepia(83%) saturate(1260%) hue-rotate(162deg) brightness(92%) contrast(93%); filter:brightness(0) saturate(100%) invert(48%) sepia(83%) saturate(1260%) hue-rotate(162deg) brightness(92%) contrast(93%); }
.tab-item.active.entering .tab-item-content { animation:tab-selected-arrive .26s ease-out; }
.tab-item.active.entering .tab-icon { animation:tab-icon-arrive .26s ease-out; }
.tab-icon { display:block; width:43rpx; height:43rpx; }
@keyframes tab-selected-arrive {
  0% { box-shadow:0 0 0 0 rgba(34,158,217,.22); }
  100% { box-shadow:0 0 0 10rpx rgba(34,158,217,0); }
}
@keyframes tab-icon-arrive {
  0% { transform:scale(.92); }
  65% { transform:scale(1.07); }
  100% { transform:scale(1); }
}
