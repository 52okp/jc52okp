<view class="page"><view class="search card"><input value="{{keyword}}" bindinput="keywordInput" bindconfirm="search" confirm-type="search" placeholder="搜索教程标题"/><button class="primary" size="mini" bindtap="search">搜索</button></view>
<article-card wx:for="{{list}}" wx:key="id" article="{{item}}" bindopen="openArticle"/>
<view wx:if="{{loading}}" class="empty">加载中…</view><view wx:elif="{{!list.length}}" class="empty">暂无内容</view><view wx:elif="{{noMore}}" class="empty">没有更多了</view></view>
