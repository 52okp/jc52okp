.home-scroll { height:100vh; background:#F5F8FD; }
.refresh-panel { width:100%; height:200rpx; padding-top:68rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; }
.refresh-bubble { width:70rpx; height:70rpx; display:flex; align-items:center; justify-content:center; border-radius:22rpx; background:#fff; color:#778397; font-size:54rpx; line-height:1; box-shadow:0 5rpx 14rpx rgba(25,36,55,.13); }
.refresh-bubble.spinning { animation:refresh-spin .8s linear infinite; }
@keyframes refresh-spin { to { transform:rotate(360deg); } }
.home-screen { min-height:100vh; background:#F5F8FD; padding-bottom:40rpx; }
.hero-stage { height:630rpx; position:relative; box-sizing:border-box; background:linear-gradient(145deg,#3478F6,#8bb8fa); }
.hero-background { position:absolute; top:0; left:0; width:100%; height:100%; z-index:1; }
.hero-veil { position:absolute; inset:0; z-index:2; background:linear-gradient(180deg,rgba(52,120,246,.28) 0%,rgba(116,172,248,.06) 70%,rgba(245,248,253,.25) 100%); pointer-events:none; }
.image-hero .hero-background { z-index:3; }
.hero-brand { position:relative; z-index:5; width:58%; padding:8rpx 0 0 32rpx; box-sizing:border-box; color:#fff; text-shadow:0 2rpx 8rpx rgba(28,75,149,.18); }
.brand-title { font-size:52rpx; line-height:1.2; font-weight:800; }
.brand-subtitle { font-size:24rpx; margin-top:8rpx; white-space:nowrap; }
.hero-card { position:relative; z-index:4; height:282rpx; margin:46rpx 28rpx 0; }
.hero-plate { position:absolute; inset:0; z-index:0; border-radius:48rpx 48rpx 0 0; background:linear-gradient(180deg,rgba(255,255,255,.92) 0%,rgba(255,255,255,.88) 72%,rgba(255,255,255,.6) 88%,rgba(255,255,255,0) 100%); }
.image-hero .hero-plate { background:linear-gradient(90deg,rgba(255,255,255,.94) 0%,rgba(255,255,255,.83) 45%,rgba(255,255,255,.12) 76%,rgba(255,255,255,0) 100%); }
.hero-character-clip { position:absolute; z-index:1; width:420rpx; height:484rpx; right:-20rpx; top:-108rpx; overflow:hidden; }
.hero-character { display:block; width:420rpx; height:526rpx; }
.hero-copy { position:relative; z-index:2; width:55%; height:100%; padding:52rpx 0 0 30rpx; box-sizing:border-box; color:#12336e; border-radius:48rpx 0 0 0; background:radial-gradient(ellipse at 0 35%,rgba(255,255,255,.62),transparent 78%); }
.hero-headline { font-size:47rpx; line-height:1.2; font-weight:800; letter-spacing:1rpx; }
.custom-headline { max-height:114rpx; overflow:hidden; word-break:break-all; }
.hero-headline text { display:block; }
.hero-description { width:330rpx; margin-top:16rpx; font-size:22rpx; line-height:1.5; color:#4b6590; }
.hero-bottom-fade { position:absolute; z-index:4; left:0; right:0; bottom:0; height:122rpx; background:linear-gradient(180deg,rgba(245,248,253,0),#F5F8FD); pointer-events:none; }
.hero-dots { position:absolute; z-index:5; left:54rpx; bottom:112rpx; display:flex; align-items:center; gap:9rpx; }
.hero-dot { width:14rpx; height:14rpx; border-radius:50%; background:rgba(52,120,246,.3); }
.hero-dot.active { width:16rpx; background:#3478F6; }
.home-content { position:relative; z-index:6; margin-top:-86rpx; padding:0 28rpx 48rpx; }
.search-shell { position:relative; z-index:7; height:92rpx; margin:0 22rpx; padding:0 14rpx 0 30rpx; display:flex; align-items:center; gap:20rpx; background:#fff; border:1rpx solid #e5ecfa; border-radius:99rpx; box-shadow:0 8rpx 24rpx rgba(51,100,173,.1); }
.search-icon { width:24rpx; height:24rpx; border:4rpx solid #7c8daa; border-radius:50%; position:relative; margin-right:4rpx; flex-shrink:0; }
.search-icon::after { content:''; width:14rpx; height:4rpx; position:absolute; right:-11rpx; bottom:-5rpx; border-radius:4rpx; background:#7c8daa; transform:rotate(48deg); }
.search-shell input { flex:1; min-width:0; font-size:24rpx; color:#162849; }
.search-placeholder { color:#9aa8bf; }
.search-go { width:64rpx; height:64rpx; border-radius:50%; background:linear-gradient(135deg,#70a5ff,#3976fa); display:flex; align-items:center; justify-content:center; box-shadow:0 4rpx 10rpx rgba(56,112,249,.18); }
.search-arrow { position:relative; width:30rpx; height:2rpx; border-radius:2rpx; background:#fff; }
.search-arrow::after { content:''; position:absolute; right:1rpx; top:-5rpx; width:10rpx; height:10rpx; border-top:2rpx solid #fff; border-right:2rpx solid #fff; transform:rotate(45deg); }
.section-heading { padding:34rpx 4rpx 18rpx; color:#192437; font-size:32rpx; font-weight:800; }
