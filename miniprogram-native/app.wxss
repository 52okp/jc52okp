page { background: #f4f8ff; color: #101d3a; font-size: 28rpx; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.page { padding: 28rpx 30rpx 48rpx; box-sizing: border-box; min-height: 100vh; background: radial-gradient(circle at 80% 0%, #dbe8ff 0, transparent 43%), #f4f8ff; }
.card { background: rgba(255,255,255,.94); border: 1rpx solid rgba(224,233,248,.8); border-radius: 28rpx; padding: 26rpx; margin-bottom: 22rpx; box-shadow: 0 12rpx 36rpx rgba(52,94,168,.06); }
.primary { background: linear-gradient(135deg,#5a8dff,#3168f8); color: #fff; border-radius: 99rpx; border: 0; }
.muted { color: #8290ab; }
.empty { text-align: center; color: #8290ab; padding: 100rpx 24rpx; font-size: 26rpx; }
button::after { border: 0; }
