.d-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}
.d-meta {
  display: flex;
  align-items: center;
  margin: 16rpx 0 28rpx;
}
.d-meta .muted {
  margin-left: 8rpx;
}

.content {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
}

.c-heading {
  font-size: 32rpx;
  font-weight: 700;
  margin: 28rpx 0 12rpx;
  padding-left: 18rpx;
  border-left: 8rpx solid #6c5ce7;
}
.c-heading:first-child {
  margin-top: 0;
}
.c-text {
  font-size: 29rpx;
  line-height: 1.8;
  color: #3a3a48;
  margin-bottom: 8rpx;
}
.c-tip {
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  color: #8a6d3b;
  margin: 16rpx 0;
  display: flex;
}
.c-tip-icon {
  margin-right: 10rpx;
}
.c-image {
  width: 100%;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

.footer-tip {
  text-align: center;
  margin: 40rpx 0;
}
.empty {
  text-align: center;
  color: #9a9aa8;
  margin-top: 160rpx;
}
