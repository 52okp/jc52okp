<view class="hero-brand-fixed {{brandContracted ? 'contracted' : ''}} {{headerHidden ? 'hidden' : ''}}" style="top:{{topInset}}px;">
  <view class="brand-title"><text>AI</text><text class="brand-suffix">教程</text></view>
  <view class="brand-subtitle">发现更好的 AI 创作方式</view>
</view>
<scroll-view class="home-scroll" scroll-y="{{true}}" enable-back-to-top="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-threshold="{{100}}" refresher-default-style="black" refresher-background="#F5F8FD" bindscroll="onHomeScroll" bindscrolltolower="loadMoreArticles" bindrefresherpulling="onRefresherPulling" bindrefresherrefresh="onRefresh" bindrefresherrestore="onRefresherRestore" bindrefresherabort="onRefresherRestore">
  <view class="home-screen">
  <view class="hero-stage {{activeBanner.characterImage ? 'layered-hero' : 'image-hero'}}" style="padding-top:{{topInset}}px;" bindtouchstart="heroTouchStart" bindtouchend="heroTouchEnd" bindtouchcancel="heroTouchCancel" bindtap="openHero">
    <image wx:if="{{activeBanner.backgroundImage}}" class="hero-background" src="{{activeBanner.backgroundImage}}" mode="aspectFill" webp="{{true}}" binderror="heroError"/>
    <view class="hero-veil"></view>
    <view class="hero-brand-space"></view>
    <view class="hero-card">
      <view class="hero-plate"></view>
      <view wx:if="{{activeBanner.characterImage}}" class="hero-character-clip"><image class="hero-character" src="{{activeBanner.characterImage}}" mode="aspectFit" webp="{{true}}" binderror="characterError"/></view>
      <view class="hero-copy">
        <view wx:if="{{activeBanner.title}}" class="hero-headline custom-headline">{{activeBanner.title}}</view>
        <view wx:else class="hero-headline">让 AI 更简单<text>更好用</text></view>
        <view class="hero-description">从入门到实战，系统学习 AI 技能</view>
      </view>
    </view>
    <view class="hero-bottom-fade"></view>
    <view wx:if="{{banners.length > 1}}" class="hero-dots">
      <view wx:for="{{banners}}" wx:key="id" class="hero-dot {{bannerIndex === index ? 'active' : ''}}" data-index="{{index}}" catchtap="selectBanner"></view>
    </view>
  </view>
  <view class="home-content">
    <view class="search-shell">
      <view class="search-icon"></view>
      <input value="{{keyword}}" bindinput="searchInput" bindconfirm="search" confirm-type="search" placeholder="搜索教程 / 模型 / 工具" placeholder-class="search-placeholder"/>
      <view class="search-go" bindtap="search"><view class="search-arrow"></view></view>
    </view>
    <view class="section-heading">
      <view class="section-tab {{articleMode === 'recommend' ? 'active' : ''}}" data-mode="recommend" role="button" catchtap="selectArticleMode">推荐</view>
      <view class="section-tab {{articleMode === 'latest' ? 'active' : ''}}" data-mode="latest" role="button" catchtap="selectArticleMode">最新文章</view>
    </view>
    <article-card wx:for="{{articles}}" wx:key="id" article="{{item}}" bindopen="openArticle"/>
    <view wx:if="{{articleMode === 'latest' ? latestLoading : loading}}" class="empty">加载中…</view><view wx:elif="{{!articles.length}}" class="empty">{{articleMode === 'latest' ? '暂无最新文章' : '暂无推荐文章'}}</view>
  </view>
  </view>
</scroll-view>
