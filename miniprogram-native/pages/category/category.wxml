<view class="layout"><scroll-view scroll-y class="side"><view wx:for="{{categories}}" wx:key="id" class="side-item {{categoryId === item.id ? 'active' : ''}}" data-index="{{index}}" bindtap="select">{{item.name}}</view><view wx:if="{{!categories.length}}" class="empty">暂无分类</view></scroll-view>
<scroll-view scroll-y class="main" bindscrolltolower="more"><view class="heading">{{categoryName}}</view><article-card wx:for="{{list}}" wx:key="id" article="{{item}}" bindopen="openArticle"/><view wx:if="{{loading}}" class="empty">加载中…</view><view wx:elif="{{!list.length}}" class="empty">该分类暂无内容</view></scroll-view></view>
