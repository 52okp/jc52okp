.tabbar-root { position:fixed; z-index:99; left:24rpx; right:24rpx; bottom:calc(12rpx + env(safe-area-inset-bottom)); height:116rpx; padding:8rpx; box-sizing:border-box; border:1rpx solid rgba(255,255,255,.92); border-radius:80rpx; background:rgba(255,255,255,.97); box-shadow:0 9rpx 30rpx rgba(34,39,48,.14); }
.tabbar-inner { position:relative; display:flex; width:100%; height:100%; }
.tab-item { flex:1; min-width:0; display:flex; align-items:center; justify-content:center; color:#3D4757; font-size:21rpx; line-height:1.2; }
.tab-item-content { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; width:112rpx; height:86rpx; box-sizing:border-box; border:1rpx solid transparent; border-radius:30rpx; }
.tab-item.active .tab-item-content { border-color:#D6E5FF; background:#EAF2FF; }
.tab-item.active { color:#2459A8; font-weight:700; }
.tab-icon { display:block; width:43rpx; height:43rpx; }
