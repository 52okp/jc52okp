.article-card { display:flex; align-items:center; gap:20rpx; padding:16rpx; margin-bottom:16rpx; border-radius:24rpx; background:#fff; box-shadow:0 10rpx 32rpx rgba(46,86,154,.055); box-sizing:border-box; }
.cover-box { width:224rpx; height:188rpx; flex-shrink:0; border-radius:18rpx; overflow:hidden; background:linear-gradient(145deg,#edf4ff,#e3eaff); display:flex; align-items:center; justify-content:center; }
.article-cover { width:100%; height:100%; }
.fallback { color:#648cf4; font-weight:900; font-size:52rpx; letter-spacing:3rpx; display:flex; align-items:center; justify-content:center; }
.article-body { flex:1; min-width:0; display:flex; flex-direction:column; justify-content:center; }
.article-tag { align-self:flex-start; color:#376cff; background:#eaf1ff; border:1rpx solid #d7e4ff; border-radius:8rpx; padding:2rpx 12rpx; font-size:20rpx; line-height:1.4; margin-bottom:8rpx; max-width:90%; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.article-title { font-size:30rpx; font-weight:750; color:#10203f; line-height:1.35; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.article-summary { font-size:24rpx; line-height:1.35; color:#8491aa; margin-top:8rpx; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.article-meta { display:flex; justify-content:space-between; gap:12rpx; color:#91a0bb; font-size:19rpx; margin-top:12rpx; white-space:nowrap; }
.compact { gap:14rpx; padding:12rpx; border-radius:18rpx; margin-bottom:14rpx; }
.compact .cover-box { width:156rpx; height:168rpx; border-radius:14rpx; }
.compact .article-title { font-size:27rpx; }
.compact .article-summary { font-size:22rpx; }
.compact .article-meta { font-size:18rpx; }
