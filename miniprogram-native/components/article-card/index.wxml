<view class="article-card {{compact ? 'compact' : ''}} {{adaptive ? 'adaptive-cover' : ''}}" bindtap="open">
  <view class="cover-box {{article.cover && !coverFailed ? '' : 'no-cover'}}">
    <image wx:if="{{article.cover && !coverFailed}}" class="article-cover" src="{{article.cover}}" mode="aspectFill" lazy-load binderror="coverError"/>
    <view wx:else class="article-cover fallback">AI</view>
  </view>
  <view class="article-body">
    <view class="article-title">{{article.title}}</view>
    <view wx:if="{{tagLabel || categoryName}}" class="article-tag">{{tagLabel || categoryName}}</view>
    <view class="article-meta">
      <text wx:if="{{dateLabel}}">◷ {{dateLabel}}</text>
    </view>
  </view>
</view>
