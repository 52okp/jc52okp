<view class="my-screen" style="padding-top:{{topInset}}px;">
  <view class="profile-card">
    <view class="avatar-shell">
      <image class="avatar" src="{{avatar}}" mode="aspectFill"/>
      <button open-type="chooseAvatar" bindchooseavatar="chooseAvatar" class="avatar-button" aria-label="更换头像"></button>
    </view>
    <view class="profile-details" bindtap="openNick">
      <view class="profile-name">{{member.nickname || '微信用户'}}</view>
      <view class="profile-id">{{member.id ? 'ID: ' + member.id : '点击设置昵称'}}</view>
    </view>
    <view class="chevron profile-chevron" bindtap="openNick">›</view>
  </view>

  <view class="section-label">我的内容</view>
  <view class="menu-card">
    <view class="menu-row" data-url="/pages/favorites/favorites" bindtap="go">
      <view class="menu-icon favorite">★</view><view class="menu-content"><text>我的收藏</text><text class="chevron">›</text></view>
    </view>
    <view class="menu-row" data-url="/pages/history/history" bindtap="go">
      <view class="menu-icon history">◷</view><view class="menu-content"><text>浏览历史</text><text class="chevron">›</text></view>
    </view>
  </view>

  <view class="section-label">应用信息</view>
  <view class="menu-card">
    <view class="menu-row" data-url="/pages/about/about" bindtap="go">
      <view class="menu-icon about">i</view><view class="menu-content"><text>关于我们</text><text class="chevron">›</text></view>
    </view>
  </view>
  <view wx:if="{{showNick}}" class="mask"><view class="dialog card"><view class="heading">设置昵称</view><input type="nickname" value="{{nicknameInput}}" bindinput="nickInput" placeholder="点击使用微信昵称或手动输入"/><view class="buttons"><button bindtap="closeNick">取消</button><button class="primary" loading="{{saving}}" bindtap="saveNick">保存</button></view></view></view>
</view>
