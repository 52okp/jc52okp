<view class="my-screen" style="padding-top:{{topInset}}px;" bindtouchstart="profileTouchStart" bindtouchmove="profileTouchMove" bindtouchend="profileTouchEnd" bindtouchcancel="profileTouchEnd">
  <view class="profile-stage {{profileSettling ? 'settling' : ''}}" style="{{profileStyle}}">
    <view class="avatar-shell" style="{{avatarStyle}}">
      <image class="avatar" src="{{avatar}}" mode="aspectFill" style="{{avatarImageStyle}}"/>
      <button disabled="{{profileProgress >= 1}}" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" class="avatar-button" aria-label="更换头像"></button>
    </view>
    <view class="goo-tail" style="{{gooTailStyle}}"></view>
    <view class="profile-name" style="{{profileNameStyle}}" bindtap="openNick">{{member.nickname || '微信用户'}}</view>
    <view class="profile-id" style="{{profileIdStyle}}">{{member.id ? 'ID: ' + member.id : '点击设置昵称'}}</view>
  </view>

  <view class="menu-card">
    <view class="menu-row" data-url="/pages/history/history" bindtap="go">
      <view class="menu-icon history">◷</view><view class="menu-content"><text>浏览历史</text><text class="chevron">›</text></view>
    </view>
    <view class="menu-row" data-url="/pages/about/about" bindtap="go">
      <view class="menu-icon about">i</view><view class="menu-content"><text>关于我们</text><text class="chevron">›</text></view>
    </view>
  </view>
  <view wx:if="{{showNick}}" class="mask"><view class="dialog card"><view class="heading">设置昵称</view><input type="nickname" value="{{nicknameInput}}" bindinput="nickInput" placeholder="点击使用微信昵称或手动输入"/><view class="buttons"><button bindtap="closeNick">取消</button><button class="primary" loading="{{saving}}" bindtap="saveNick">保存</button></view></view></view>
</view>
