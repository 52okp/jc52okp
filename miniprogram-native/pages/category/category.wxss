.category-screen { height:100vh; display:flex; flex-direction:column; overflow:hidden; background:#F5F8FD; }
.category-header { position:relative; flex-shrink:0; overflow:hidden; padding:0 32rpx 88rpx; box-sizing:border-box; border-radius:0 0 38rpx 38rpx; background:linear-gradient(115deg,#3478F6 0%,#5a97fa 60%,#81b7fb 100%); color:#fff; }
.header-orbit { position:absolute; border:2rpx solid rgba(255,255,255,.16); border-radius:50%; pointer-events:none; }
.orbit-one { width:310rpx; height:310rpx; right:-70rpx; top:-126rpx; }
.orbit-two { width:208rpx; height:208rpx; right:74rpx; top:70rpx; background:rgba(255,255,255,.055); }
.header-title,.header-subtitle { position:relative; z-index:1; }
.header-title { font-size:48rpx; font-weight:800; line-height:1.12; }
.header-subtitle { margin-top:10rpx; color:rgba(255,255,255,.91); font-size:24rpx; }
.category-tabs { position:relative; z-index:2; flex-shrink:0; display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin:-44rpx 24rpx 0; padding:18rpx 18rpx 20rpx; box-sizing:border-box; border:1rpx solid #e9effa; border-radius:30rpx; background:#fff; box-shadow:0 12rpx 30rpx rgba(48,94,169,.085); }
.tabs-caption { width:100%; display:flex; align-items:center; gap:10rpx; padding:2rpx 6rpx 6rpx; box-sizing:border-box; color:#778397; font-size:22rpx; font-weight:600; }
.caption-mark { width:7rpx; height:19rpx; border-radius:8rpx; background:#3478F6; }
.category-tab { flex-shrink:0; max-width:100%; padding:12rpx 22rpx; box-sizing:border-box; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; border:1rpx solid #e4ebf6; border-radius:40rpx; background:#f8faff; color:#52617b; font-size:24rpx; line-height:1.25; }
.category-tab.active { color:#fff; background:#3478F6; border-color:#3478F6; box-shadow:0 5rpx 12rpx rgba(52,120,246,.18); }
.category-list { flex:1; min-height:0; padding:0 24rpx 36rpx; box-sizing:border-box; }
.list-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:16rpx; padding:32rpx 4rpx 20rpx; }
.list-heading-copy { min-width:0; }
.list-eyebrow { color:#778397; font-size:21rpx; line-height:1.2; }
.list-title { margin-top:5rpx; color:#192437; font-size:34rpx; line-height:1.3; font-weight:800; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.list-total { flex-shrink:0; margin-bottom:3rpx; padding:7rpx 16rpx; border-radius:40rpx; background:#e9f1ff; color:#3478F6; font-size:21rpx; }
.result-empty { margin-top:16rpx; padding:72rpx 8rpx; border-radius:24rpx; background:#fff; color:#9aa7bb; text-align:center; font-size:23rpx; }
.result-end { display:flex; align-items:center; justify-content:center; gap:15rpx; padding:42rpx 8rpx 48rpx; color:#9aa7bb; text-align:center; font-size:21rpx; white-space:nowrap; }
.end-rule { width:42rpx; height:1rpx; background:#d8e1ef; }
.category-bottom-space { height:calc(150rpx + env(safe-area-inset-bottom)); }
