.tabbar-root { position:fixed; z-index:99; left:24rpx; right:24rpx; bottom:calc(12rpx + env(safe-area-inset-bottom)); height:116rpx; padding:8rpx; box-sizing:border-box; border:1rpx solid rgba(255,255,255,.92); border-radius:80rpx; background:rgba(255,255,255,.97); box-shadow:0 9rpx 30rpx rgba(34,39,48,.14); }
.tabbar-inner { position:relative; display:flex; width:100%; height:100%; }
.tab-indicator { position:absolute; top:0; left:0; width:33.333333%; height:100%; box-sizing:border-box; border:1rpx solid #cfd1d4; border-radius:70rpx; background:#e5e6e8; box-shadow:0 2rpx 9rpx rgba(35,40,48,.08); opacity:0; }
.tab-indicator.visible { opacity:1; }
.tab-indicator.animated { transition:left .18s ease; }
.tab-indicator.at-1 { left:33.333333%; }
.tab-indicator.at-2 { left:66.666667%; }
.tab-item { position:relative; z-index:1; flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; color:#30343b; font-size:21rpx; line-height:1.2; }
.tab-item.active { color:#17191C; font-weight:700; }
.tab-icon { display:block; width:43rpx; height:43rpx; }
