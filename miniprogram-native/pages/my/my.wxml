<view class="page"><view class="profile card"><button open-type="chooseAvatar" bindchooseavatar="chooseAvatar" class="avatar-button"><image class="avatar" src="{{avatar}}" mode="aspectFill"/></button><view class="name" bindtap="openNick"><view>{{member.nickname || '微信用户'}}</view><view class="small">{{member.nickname ? 'ID: ' + member.id : '点击设置昵称'}}</view></view></view>
<view class="card menu"><view data-url="/pages/favorites/favorites" bindtap="go">⭐ 我的收藏　›</view><view data-url="/pages/history/history" bindtap="go">🕘 浏览历史　›</view></view>
<view class="card menu"><view data-url="/pages/about/about" bindtap="go">ℹ️ 关于我们　›</view></view>
<view wx:if="{{showNick}}" class="mask"><view class="dialog card"><view class="heading">设置昵称</view><input type="nickname" value="{{nicknameInput}}" bindinput="nickInput" placeholder="点击使用微信昵称或手动输入"/><view class="buttons"><button bindtap="closeNick">取消</button><button class="primary" loading="{{saving}}" bindtap="saveNick">保存</button></view></view></view></view>
