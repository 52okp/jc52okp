<view class="page explore-page">
  <view class="page-heading">{{heading}}</view><view class="page-subtitle">发现值得收藏的 AI 教程</view>
  <view class="search-shell"><text class="search-glyph">⌕</text><input value="{{keyword}}" bindinput="keywordInput" bindconfirm="search" confirm-type="search" placeholder="搜索教程标题"/><view class="search-button" bindtap="search">搜索</view></view>
  <view wx:if="{{total}}" class="result-count">找到 {{total}} 篇教程</view>
  <article-card wx:for="{{list}}" wx:key="id" article="{{item}}" bindopen="openArticle"/>
  <view wx:if="{{loading}}" class="empty">加载中…</view><view wx:elif="{{!list.length}}" class="empty">暂无内容，换个关键词试试</view><view wx:elif="{{noMore}}" class="end-note">已经看完啦</view>
</view>
