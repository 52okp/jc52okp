.about-card {
  text-align: center;
  padding: 48rpx 28rpx;
}
.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 120rpx;
  margin: 0 auto 20rpx;
}
.app-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f8;
  font-size: 29rpx;
}
.row:last-child {
  border-bottom: none;
}

.tips-title {
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
