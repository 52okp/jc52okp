.page { padding: 64rpx 36rpx 48rpx; min-height: 100vh; box-sizing: border-box; }
.brand { font-size: 44rpx; font-weight: 800; margin-bottom: 44rpx; }
.brand text { font-size: 24rpx; font-weight: 400; color: #7b8ca6; margin-left: 18rpx; }
.card { padding: 44rpx 34rpx; }
.badge,.policy { color: #2f7bff; }
.title { font-size: 40rpx; font-weight: 800; margin: 22rpx 0; }
.description { color: #687b95; line-height: 1.8; }
.platform { padding: 30rpx 24rpx; background: #edf3ff; color: #2468d8; border-radius: 18rpx; margin: 32rpx 0; font-size: 34rpx; font-weight: 700; word-break: break-all; }
.agreement { display: flex; align-items: center; margin-top: 30rpx; }
.policy { margin: 8rpx 0 26rpx 56rpx; }
button { margin-top: 22rpx; }
.tip,.footer { text-align: center; color: #7b8ca6; font-size: 24rpx; margin-top: 28rpx; }
.error { color: #b44936; margin: 18rpx 0; }
.result { text-align: center; }
.symbol { color: #2f7bff; font-size: 64rpx; }
