.tabbar-root { position:fixed; z-index:99; left:0; right:0; width:calc(100% - 16px); max-width:264px; margin:0 auto; bottom:calc(8px + env(safe-area-inset-bottom)); height:56px; padding:4px; box-sizing:border-box; border:1rpx solid #E7EFF4; border-radius:28px; background:rgba(255,255,255,.97); box-shadow:0 3px 11px rgba(34,66,88,.10); }
.tabbar-inner { position:relative; display:flex; width:100%; height:100%; }
.tab-item { flex:1; min-width:0; display:flex; align-items:center; justify-content:center; color:#293440; font-size:12px; line-height:1.2; }
.tab-item-content { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; width:78px; max-width:100%; height:100%; box-sizing:border-box; border-radius:24px; }
.tab-item.active .tab-item-content { background:#EAF7FC; }
.tab-item.active { color:#168FCC; font-weight:700; }
.tab-item.active.entering .tab-item-content { animation:tab-selected-arrive .32s ease-out; }
.tab-item.active.entering .tab-icon { animation:tab-icon-arrive .32s ease-out; }
.tab-icon { display:block; width:43rpx; height:43rpx; }
@keyframes tab-selected-arrive {
  0% { box-shadow:0 0 0 0 rgba(34,158,217,.22); }
  100% { box-shadow:0 0 0 6rpx rgba(34,158,217,0); }
}
@keyframes tab-icon-arrive {
  0% { transform:scale(.92); }
  65% { transform:scale(1.07); }
  100% { transform:scale(1); }
}
