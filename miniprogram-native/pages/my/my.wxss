.my-screen {
  min-height: 100vh;
  padding: 0 28rpx calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F5F8FD;
}

.profile-stage {
  position: sticky;
  z-index: 5;
  box-sizing: border-box;
  background: #F5F8FD;
}
.profile-stage.settling { transition: height .36s cubic-bezier(.2,.75,.25,1); }
.profile-stage.settling .avatar-shell { transition: top .36s cubic-bezier(.2,.75,.25,1), width .36s cubic-bezier(.2,.75,.25,1), height .36s cubic-bezier(.2,.75,.25,1), margin-left .36s cubic-bezier(.2,.75,.25,1), opacity .36s ease, background .36s ease; }
.profile-stage.settling .avatar { transition: opacity .36s ease; }
.profile-stage.settling .goo-tail { transition: top .36s cubic-bezier(.2,.75,.25,1), border-width .36s ease, opacity .36s ease; }
.profile-stage.settling .profile-name { transition: top .36s cubic-bezier(.2,.75,.25,1), left .36s cubic-bezier(.2,.75,.25,1), transform .36s cubic-bezier(.2,.75,.25,1), font-size .36s ease; }
.profile-stage.settling .profile-id { transition: top .36s cubic-bezier(.2,.75,.25,1), opacity .36s ease; }
.profile-stage.settling .profile-actions { transition: opacity .22s ease, transform .36s cubic-bezier(.2,.75,.25,1); }

.avatar-shell {
  position: absolute;
  left: 50%;
  z-index: 2;
  overflow: hidden;
  border-radius: 50%;
  background: #e6edf8;
}

.avatar { display: block; width: 100%; height: 100%; border-radius: 50%; }
.avatar-button {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
}

.goo-tail { position: absolute; left: 50%; z-index: 3; width: 0; height: 0; transform: translateX(-50%); pointer-events: none; }
.profile-name { position: absolute; z-index: 4; max-width: 90%; overflow: hidden; color: #192437; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.profile-id { position: absolute; left: 0; right: 0; overflow: hidden; color: #778397; font-size: 23rpx; text-align: center; white-space: nowrap; text-overflow: ellipsis; }
.profile-actions { position: absolute; left: 0; right: 0; bottom: 12rpx; display: flex; gap: 16rpx; }
.profile-action { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 108rpx; padding: 0; margin: 0; border-radius: 26rpx; background: #fff; color: #192437; font-size: 23rpx; line-height: 1.2; }
.profile-action:active { background: #eaf1ff; }
.action-camera { position: relative; box-sizing: border-box; width: 38rpx; height: 30rpx; margin: 4rpx 0 10rpx; border: 3rpx solid currentColor; border-radius: 7rpx; }
.action-camera::before { content: ''; position: absolute; box-sizing: border-box; left: 10rpx; top: 6rpx; width: 12rpx; height: 12rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.action-camera::after { content: ''; position: absolute; left: 5rpx; top: -8rpx; width: 14rpx; height: 5rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 4rpx 4rpx 0 0; }
.action-pencil { height: 44rpx; margin-bottom: 1rpx; font-size: 43rpx; line-height: 44rpx; }

.menu-card { overflow: hidden; margin-top: 22rpx; border-radius: 22rpx; background: #fff; }
.menu-row { display: flex; align-items: center; min-height: 104rpx; padding-left: 26rpx; box-sizing: border-box; }
.menu-row:active { background: #f7f9fd; }
.menu-icon {
  display: block;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  margin: 0 24rpx 0 4rpx;
}
.menu-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  min-height: 104rpx;
  padding-right: 28rpx;
  border-bottom: 1rpx solid #edf0f5;
  box-sizing: border-box;
  color: #192437;
  font-size: 29rpx;
}
.menu-row:last-child .menu-content { border-bottom: 0; }
.chevron { color: #a4adbd; font-size: 42rpx; font-weight: 300; line-height: 1; }

.mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; background: rgba(18,36,70,.42); }
.dialog { width: 570rpx; margin: 0; padding: 36rpx; }
.heading { margin-bottom: 28rpx; font-size: 32rpx; font-weight: 800; text-align: center; }
.dialog input { padding: 20rpx; border: 1rpx solid #dbe6f8; border-radius: 16rpx; }
.buttons { display: flex; gap: 20rpx; margin-top: 28rpx; }
.buttons button { flex: 1; border-radius: 99rpx; }
