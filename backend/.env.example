# 数据配置
DB_TYPE=mysql
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_PREFIX=
DB_MYSQL_USERNAME=ai_tutorial
DB_MYSQL_DATABASE=ai_tutorial
DB_MYSQL_CHARSET=utf8mb4
DB_MYSQL_PASSWORD=

# 缓存配置
CACHE_TYPE=file
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_SELECT=
CACHE_REDIS_PASSWORD=

# 会话配置
SESSION_TYPE=file
SESSION_NAME=ssid
SESSION_STORE=
SESSION_EXPIRE=7200
SESSION_PREFIX=
# 微信小程序
WXAPP_APPID=
WXAPP_SECRET=

# WordPress 教程同步，密钥请只放在非公开服务器环境中
WP_SYNC_SITE_ID=
WP_SYNC_SECRET=
WP_SYNC_MAINTENANCE=0

# 52okp 项目只读更新令牌，须使用本项目独立身份
OSS_ORIGIN=https://app.52okp.com
OSS_PROJECT=
OSS_TOKEN=
APP_VERSION=
UPDATE_PHP_CLI=
