.my-screen {
  min-height: 100vh;
  padding: 0 28rpx calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F5F8FD;
}

.profile-card {
  display: flex;
  align-items: center;
  min-height: 184rpx;
  padding: 22rpx 28rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #fff;
}

.avatar-shell {
  position: relative;
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  margin-right: 24rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #e6edf8;
}

.avatar { display: block; width: 100%; height: 100%; border-radius: 50%; }
.avatar-button {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
}

.profile-details { flex: 1; min-width: 0; padding: 10rpx 0; }
.profile-name { overflow: hidden; color: #192437; font-size: 35rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.profile-id { margin-top: 8rpx; color: #778397; font-size: 23rpx; }
.profile-chevron { margin-left: 16rpx; }

.section-label {
  margin: 42rpx 10rpx 14rpx;
  color: #778397;
  font-size: 24rpx;
  font-weight: 500;
}

.menu-card { overflow: hidden; border-radius: 22rpx; background: #fff; }
.menu-row { display: flex; align-items: center; min-height: 104rpx; padding-left: 26rpx; box-sizing: border-box; }
.menu-row:active { background: #f7f9fd; }
.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin-right: 22rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
}
.menu-icon.favorite { background: #5b8ff9; }
.menu-icon.history { background: #5bb7ad; font-size: 39rpx; }
.menu-icon.about { background: #8d9db5; font-size: 32rpx; font-weight: 700; }
.menu-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  min-height: 104rpx;
  padding-right: 28rpx;
  border-bottom: 1rpx solid #edf0f5;
  box-sizing: border-box;
  color: #192437;
  font-size: 29rpx;
}
.menu-row:last-child .menu-content { border-bottom: 0; }
.chevron { color: #a4adbd; font-size: 42rpx; font-weight: 300; line-height: 1; }

.mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; background: rgba(18,36,70,.42); }
.dialog { width: 570rpx; margin: 0; padding: 36rpx; }
.heading { margin-bottom: 28rpx; font-size: 32rpx; font-weight: 800; text-align: center; }
.dialog input { padding: 20rpx; border: 1rpx solid #dbe6f8; border-radius: 16rpx; }
.buttons { display: flex; gap: 20rpx; margin-top: 28rpx; }
.buttons button { flex: 1; border-radius: 99rpx; }
